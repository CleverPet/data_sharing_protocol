{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/FluentPet/data_sharing_protocol/schema/eventstream.schema.json",
    "title": "Eventstream",
    "description": "A JSON eventstream for interspecies AAC device interactions.",
    "type": "object",
    "required": ["id", "provenance", "start", "end", "agents", "events"],
    "additionalProperties": true,
    "properties": {
        "schema_version": {
            "type": "string",
            "description": "Schema version in semver format.",
            "default": "1.1.0"
        },
        "id": {
            "type": "string",
            "description": "Provenance-scoped id of the eventstream file."
        },
        "provenance": {
            "type": "string",
            "description": "Id of the data producer."
        },
        "start": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the stream (ISO 8601)."
        },
        "end": {
            "type": "string",
            "format": "date-time",
            "description": "End of the stream (ISO 8601)."
        },
        "agents": {
            "type": "array",
            "description": "List of agents in this eventstream.",
            "items": { "$ref": "#/$defs/Agent" }
        },
        "events": {
            "type": "array",
            "description": "List of events in this eventstream.",
            "items": { "$ref": "#/$defs/Event" }
        }
    },
    "$defs": {
        "Agent": {
            "type": "object",
            "description": "An agent who may generate events.",
            "required": ["id", "species"],
            "additionalProperties": true,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Provenance-scoped agent id."
                },
                "species": {
                    "type": "string",
                    "description": "Species name in binomial nomenclature."
                },
                "metadata": {
                    "type": "object",
                    "description": "Optional metadata (breed, age, sex, name, training_method, etc.).",
                    "additionalProperties": true
                },
                "group_id": {
                    "type": "string",
                    "description": "Optional group identifier for multi-agent scenarios."
                },
                "role": {
                    "type": "string",
                    "description": "Optional role (e.g., learner, teacher, observer)."
                }
            }
        },
        "Event": {
            "type": "object",
            "description": "An extendable event representing an occurrence in time.",
            "required": ["id", "type", "start"],
            "additionalProperties": true,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "File-scoped event id."
                },
                "type": {
                    "type": "string",
                    "description": "Event type (e.g., button_press, vocalization, utterance)."
                },
                "agent": {
                    "type": "string",
                    "description": "Agent id who caused the event."
                },
                "start": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Start of the event (ISO 8601)."
                },
                "end": {
                    "type": "string",
                    "format": "date-time",
                    "description": "End of the event (ISO 8601)."
                },
                "content": {
                    "type": "string",
                    "description": "Event content (e.g., button label, transcript)."
                },
                "other_data": {
                    "type": "object",
                    "description": "Extendable object for additional event data.",
                    "additionalProperties": true
                },
                "context": {
                    "type": "object",
                    "description": "Environmental context data.",
                    "additionalProperties": true
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Confidence score for automated/inferred events."
                },
                "media_refs": {
                    "type": "array",
                    "description": "References to linked media recordings.",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "annotations": {
                    "type": "array",
                    "description": "Researcher-added metadata annotations.",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        }
    }
}
