{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/FluentPet/data_sharing_protocol/schema/eventstream.schema.json",
    "title": "Eventstream",
    "description": "A JSON eventstream for interspecies AAC device interactions.",
    "type": "object",
    "required": ["id", "provenance", "start", "end", "agents", "events"],
    "additionalProperties": true,
    "properties": {
        "schema_version": {
            "type": "string",
            "description": "Schema version in semver format.",
            "default": "1.1.0"
        },
        "id": {
            "type": "string",
            "description": "Provenance-scoped id of the eventstream file."
        },
        "provenance": {
            "type": "string",
            "description": "Id of the data producer."
        },
        "start": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the stream (ISO 8601)."
        },
        "end": {
            "type": "string",
            "format": "date-time",
            "description": "End of the stream (ISO 8601)."
        },
        "agents": {
            "type": "array",
            "description": "List of agents in this eventstream.",
            "items": { "$ref": "#/$defs/Agent" }
        },
        "events": {
            "type": "array",
            "description": "List of events in this eventstream.",
            "items": { "$ref": "#/$defs/Event" }
        }
    },
    "$defs": {
        "Agent": {
            "type": "object",
            "description": "An agent who may generate events.",
            "required": ["id", "species"],
            "additionalProperties": true,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Provenance-scoped agent id."
                },
                "species": {
                    "type": "string",
                    "description": "Species name in binomial nomenclature."
                },
                "metadata": {
                    "type": "object",
                    "description": "Optional metadata (breed, age, sex, name, training_method, etc.).",
                    "additionalProperties": true
                },
                "group_id": {
                    "type": "string",
                    "description": "Optional group identifier for multi-agent scenarios."
                },
                "role": {
                    "type": "string",
                    "description": "Optional role (e.g., learner, teacher, observer)."
                },
                "communication_profile": {
                    "type": "object",
                    "description": "Communication capabilities and sensory ranges for this agent.",
                    "additionalProperties": true,
                    "properties": {
                        "hearing_range_hz": {
                            "type": "array",
                            "description": "Hearing range as [min, max] in Hz.",
                            "items": { "type": "number" },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "vocalization_range_hz": {
                            "type": "array",
                            "description": "Vocalization range as [min, max] in Hz.",
                            "items": { "type": "number" },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "primary_modalities": {
                            "type": "array",
                            "description": "Primary communication modalities (e.g., acoustic, ultrasonic, visual, chemical).",
                            "items": { "type": "string" }
                        },
                        "description": {
                            "type": "string",
                            "description": "Free-text description of communication capabilities."
                        }
                    }
                }
            }
        },
        "Event": {
            "type": "object",
            "description": "An extendable event representing an occurrence in time.",
            "required": ["id", "type", "start"],
            "additionalProperties": true,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "File-scoped event id."
                },
                "type": {
                    "type": "string",
                    "description": "Event type (e.g., button_press, vocalization, utterance)."
                },
                "agent": {
                    "type": "string",
                    "description": "Agent id who caused the event."
                },
                "start": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Start of the event (ISO 8601)."
                },
                "end": {
                    "type": "string",
                    "format": "date-time",
                    "description": "End of the event (ISO 8601)."
                },
                "content": {
                    "type": "string",
                    "description": "Event content (e.g., button label, transcript)."
                },
                "other_data": {
                    "type": "object",
                    "description": "Extendable object for additional event data.",
                    "additionalProperties": true
                },
                "context": {
                    "type": "object",
                    "description": "Environmental context data.",
                    "additionalProperties": true
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Confidence score for automated/inferred events."
                },
                "media_refs": {
                    "type": "array",
                    "description": "References to linked media recordings.",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "annotations": {
                    "type": "array",
                    "description": "Researcher-added metadata annotations.",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "duration_ms": {
                    "type": "number",
                    "description": "Duration in milliseconds. Supports sub-millisecond precision for fast signals like bat echolocation."
                },
                "parent_id": {
                    "type": "string",
                    "description": "Parent event id for hierarchical events (e.g., song > theme > phrase > unit)."
                },
                "signal": {
                    "type": "object",
                    "description": "Signal-level data for acoustic, electric, visual, or other communication signals.",
                    "additionalProperties": true,
                    "properties": {
                        "freq_min_hz": {
                            "type": "number",
                            "description": "Minimum frequency in Hz."
                        },
                        "freq_max_hz": {
                            "type": "number",
                            "description": "Maximum frequency in Hz."
                        },
                        "dominant_freq_hz": {
                            "type": "number",
                            "description": "Dominant frequency in Hz."
                        },
                        "bandwidth_hz": {
                            "type": "number",
                            "description": "Signal bandwidth in Hz."
                        },
                        "call_type": {
                            "type": "string",
                            "description": "Type of call or signal (e.g., signature_whistle, echolocation_click, song)."
                        },
                        "contour_points": {
                            "type": "array",
                            "description": "Frequency contour as array of [time_offset_ms, freq_hz] pairs.",
                            "items": {
                                "type": "array",
                                "items": { "type": "number" },
                                "minItems": 2,
                                "maxItems": 2
                            }
                        },
                        "modality": {
                            "type": "string",
                            "description": "Signal modality (acoustic, ultrasonic, infrasonic, vibration, electric, visual, chemical)."
                        }
                    }
                },
                "recording": {
                    "type": "object",
                    "description": "Recording metadata linking the event to raw sensor data.",
                    "additionalProperties": true,
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "Recording source (e.g., hydrophone, microphone, accelerometer)."
                        },
                        "channel": {
                            "type": "integer",
                            "description": "Channel number in multi-channel recording."
                        },
                        "sample_rate_hz": {
                            "type": "number",
                            "description": "Sample rate in Hz."
                        },
                        "file": {
                            "type": "string",
                            "description": "Filename or path to raw recording."
                        },
                        "offset_samples": {
                            "type": "integer",
                            "description": "Offset in samples from start of recording file."
                        },
                        "format": {
                            "type": "string",
                            "description": "File format (e.g., wav, flac, mp3)."
                        }
                    }
                },
                "classification": {
                    "type": "object",
                    "description": "Automated or manual classification of the event.",
                    "additionalProperties": true,
                    "properties": {
                        "method": {
                            "type": "string",
                            "description": "Classification method (e.g., manual, cnn, template_matching)."
                        },
                        "label": {
                            "type": "string",
                            "description": "Classification label."
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Classification confidence score (0-1)."
                        },
                        "model_version": {
                            "type": "string",
                            "description": "Version of the classification model."
                        },
                        "taxonomy": {
                            "type": "string",
                            "description": "Reference to the classification taxonomy used."
                        }
                    }
                }
            }
        }
    }
}
